# Old WordPress URLs still indexed by Google -> matching pages on the new site.
# Format: [source] [destination] [code]. 301 so search engines transfer ranking.
# Targets are extensionless: Workers serves /about from about.html and 307s
# /about.html -> /about, so pointing at the .html would cost a second hop.

# Front page: WordPress kept a /home/ slug alongside the root.
/home             /            301
/home/            /            301

# "About me" / "What I do" both described Faye, which is now one page.
# (/about itself is a real page here, so it needs no rule.)
/about-me         /about       301
/about-me/        /about       301
/services         /about       301
/services/        /about       301

# "Creative" was the artwork.
/creative         /art         301
/creative/        /art         301

# "Editorial portfolio" and the two portfolio slugs were the client work.
/brand-portfolio  /editorial   301
/brand-portfolio/ /editorial   301
/portfolio        /editorial   301
/portfolio/       /editorial   301
/portfolio-new    /editorial   301
/portfolio-new/   /editorial   301

# WordPress feeds have no equivalent; send them home rather than 404.
/feed             /            301
/feed/            /            301
/comments/feed    /            301
/comments/feed/   /            301
