{#- One artwork tile. Used by the home page and the gallery, so a change
    to how work is presented happens once, here.
    Fields come from _data/gallery.js — see the notes at the top of that file.
    `ratio` overrides the piece's own ratio, so a row can share one shape. -#}

{% macro tile(w, reveal = false, extraClass = '', ratio = '') %}
{%- if w.placeholder -%}
<figure class="work work--placeholder{{ ' ' + extraClass if extraClass }}"{% if reveal %} data-reveal{% endif %} style="cursor:default" data-type="{{ w.label or 'other' }}">
  <div class="placeholder"><span>{{ w.label or 'coming soon' }}</span></div>
  <figcaption><span class="work__title">{{ w.title }}</span><span>{{ w.meta or 'Coming' }}</span></figcaption>
</figure>
{%- else -%}
<figure class="work{{ ' ' + extraClass if extraClass }}"{% if reveal %} data-reveal{% endif %} tabindex="0" role="button" aria-label="View {{ w.title }}" data-full="{{ w.full or w.src }}" data-type="{{ w.type or 'other' }}">
  <div class="frame {{ ratio or w.ratio or 'sq' }}{{ ' frame--contain frame--paper' if w.contain }}">
    <img src="{{ w.src }}" alt="{{ w.alt or w.title }}"{% if w.eager %} fetchpriority="high"{% else %} loading="lazy"{% endif %}{% if w.position %} style="object-position:{{ w.position }}"{% endif %}>
  </div>
  <figcaption><span class="work__title">{{ w.title }}</span><span>{{ w.meta or '' }}</span></figcaption>
</figure>
{%- endif -%}
{% endmacro %}
